# Copy to .env (or run: bash scripts/generate-env.sh). Never commit .env.

# --- Project 2 (ops-report-automation), used by the included compose file ---
POSTGRES_PASSWORD=
REPORT_ENGINE_API_KEY=
N8N_ENCRYPTION_KEY=

# --- Project 1 (ticket-triage-agent) ---
TRIAGE_DB_PASSWORD=
TRIAGE_API_KEY=
# keyword = rule-based baseline, no cost. claude = needs ANTHROPIC_API_KEY.
TRIAGE_AGENT=keyword

# --- Project 3 (this portal) ---
PORTAL_DB_PASSWORD=
# Two accounts: viewer (read only) and operator (can run reports). Blank = account disabled.
PORTAL_VIEWER_PASSWORD=
PORTAL_OPERATOR_PASSWORD=
# Minutes a person takes to triage one ticket by hand. Measure yours; used for "hours saved".
TRIAGE_MANUAL_MINUTES=2

# --- Optional ---
# Enables Claude in both projects (triage with TRIAGE_AGENT=claude, report summaries).
ANTHROPIC_API_KEY=
